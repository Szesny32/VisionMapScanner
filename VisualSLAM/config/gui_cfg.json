{
    "stereo_config": {
        "min_depth": 0.1,
        "max_depth": 10.0,
        "width": 1080,
        "height": 720,
        "baseline": 0.38,
        "min_disp": 0,
        "num_disp_multiplier": 8,
        "block_size": 3,
        "p2_scale": 1.2,
        "wls_lambda": 8000.0,
        "wls_sigma": 1.5
    },
    "layers": [
        {
            "type": "CameraLayer",
            "name": "Left Camera",
            "args": [
                "Left Camera",
                "left"
            ],
            "enabled": true,
            "grid_span": 1,
            "inputs": [
                "left"
            ],
            "params": {}
        },
        {
            "type": "CameraLayer",
            "name": "Right Camera",
            "args": [
                "Right Camera",
                "right"
            ],
            "enabled": true,
            "grid_span": 1,
            "inputs": [
                "right"
            ],
            "params": {}
        },
        {
            "type": "GTDepthLayer",
            "name": "GT Depth (Unity)",
            "enabled": true,
            "grid_span": 1,
            "inputs": [],
            "outputs": [
                "depth_map_gt"
            ],
            "provides": {
                "depth_map": "depth_map_gt"
            },
            "params": {
                "topic": "/stereo/camera_depth"
            }
        },
        {
            "type": "StereoLayer",
            "name": "Stereo & Depth",
            "enabled": true,
            "grid_span": 1,
            "inputs": [
                "left",
                "right",
                "f",
                "baseline"
            ],
            "outputs": [
                "depth_map"
            ],
            "params": {
                "wls_lambda": 100000.0
            }
        },
        {
            "type": "KeypointLayer",
            "name": "Keypoint Matching",
            "enabled": false,
            "grid_span": 2,
            "inputs": [
                "left",
                "right"
            ],
            "outputs": [
                "matches_visual"
            ],
            "provides": {
                "matches_visual": "matches_visual"
            },
            "params": {
                "nfeatures": 500,
                "max_draw_matches": 50
            }
        },
        {
            "type": "OctreeLayer",
            "name": "3D Point Cloud View",
            "enabled": true,
            "grid_span": 1,
            "inputs": [
                "depth_map",
                "left",
                "f",
                "baseline",
                "robot_pose"
            ],
            "sources": {
                "depth_map": "depth_map"
            },
            "params": {}
        },
        {
            "type": "OccupancyGridLayer",
            "name": "2D Occupancy Grid",
            "enabled": true,
            "grid_span": 2,
            "inputs": [
                "depth_map",
                "f",
                "baseline",
                "robot_pose"
            ],
            "sources": {
                "depth_map": "depth_map"
            },
            "params": {
                "resolution": 0.05
            }
        }
    ]
}
