{
    "layers": [
        {
            "type": "CameraLayer",
            "name": "Left Camera",
            "args": [
                "Left Camera",
                "left"
            ],
            "enabled": true,
            "grid_span": 1,
            "inputs": [
                "left"
            ],
            "params": {}
        },
        {
            "type": "CameraLayer",
            "name": "Right Camera",
            "args": [
                "Right Camera",
                "right"
            ],
            "enabled": true,
            "grid_span": 1,
            "inputs": [
                "right"
            ],
            "params": {}
        },
        {
            "type": "StereoLayer",
            "name": "Stereo & Depth",
            "enabled": true,
            "grid_span": 1,
            "inputs": [
                "left",
                "right",
                "f",
                "baseline"
            ],
            "outputs": [
                "depth_map"
            ],
            "params": {
                "max_depth": 10.0,
                "wls_lambda": 8000.0
            }
        },
        {
            "type": "GTDepthLayer",
            "name": "GT Depth (Unity)",
            "enabled": true,
            "grid_span": 1,
            "inputs": [],
            "outputs": [
                "depth_map_gt"
            ],
            "provides": {
                "depth_map": "depth_map_gt"
            },
            "params": {
                "topic": "/stereo/camera_depth"
            }
        },
        {
            "type": "KeypointLayer",
            "name": "Keypoint Matching",
            "enabled": false,
            "grid_span": 2,
            "inputs": [
                "left",
                "right"
            ],
            "outputs": [
                "matches_visual"
            ],
            "provides": {
                "matches_visual": "matches_visual"
            },
            "params": {
                "nfeatures": 500,
                "max_draw_matches": 50
            }
        },
        {
            "type": "OctreeLayer",
            "name": "3D Point Cloud View",
            "enabled": true,
            "grid_span": 1,
            "inputs": [
                "depth_map",
                "left",
                "f",
                "baseline",
                "robot_pose"
            ],
            "sources": {
                "depth_map": "depth_map"
            },
            "params": {}
        },
        {
            "type": "OccupancyGridLayer",
            "name": "2D Occupancy Grid",
            "enabled": true,
            "grid_span": 2,
            "inputs": [
                "depth_map",
                "f",
                "baseline",
                "robot_pose"
            ],
            "sources": {
                "depth_map": "depth_map"
            },
            "params": {
                "resolution": 0.05
            }
        }
    ]
}